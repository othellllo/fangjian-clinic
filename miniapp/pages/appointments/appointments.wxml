<view class="page appointments-page">
  <view class="hero">
    <view class="hero-title">我的预约</view>
    <view class="hero-sub">到店后请先在前台报到，等待医生叫号</view>
  </view>

  <view wx:if="{{loading}}" class="loading-tip">正在加载预约…</view>

  <view wx:elif="{{error}}" class="hint-card gap-top" bindtap="onRetry">预约记录加载失败，点击重试</view>

  <block wx:elif="{{!upcoming.length && !history.length}}">
    <view class="empty">
      <view class="empty-icon">约</view>
      <view class="empty-text">还没有预约记录</view>
      <view class="empty-sub">选个医生，给自己安排一次问诊吧</view>
      <view class="btn-primary empty-btn" hover-class="btn-hover" bindtap="goBooking">去预约</view>
    </view>
  </block>

  <block wx:else>
    <view class="group-title">
      <text class="group-name">即将就诊</text>
      <text class="group-count">{{upcoming.length}}</text>
    </view>

    <view wx:if="{{!upcoming.length}}" class="hint-card">
      暂时没有即将就诊的预约
      <text class="link-text" bindtap="goBooking">去预约</text>
    </view>

    <view wx:for="{{upcoming}}" wx:key="id" class="card appt-card">
      <view class="appt-top">
        <view class="appt-doctor">
          <text class="doctor-name">{{item.doctorName}}</text>
          <text class="doctor-title" wx:if="{{item.doctorTitle}}">{{item.doctorTitle}}</text>
        </view>
        <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
      </view>

      <view class="meta-row">
        <text class="meta-label">就诊时间</text>
        <text class="meta-value">{{item.dateTimeText}}</text>
      </view>
      <view class="meta-row">
        <text class="meta-label">预约号</text>
        <text class="meta-value">{{item.appointNo || '-'}}</text>
      </view>
      <view class="meta-row" wx:if="{{item.complaint}}">
        <text class="meta-label">主诉</text>
        <text class="meta-value">{{item.complaint}}</text>
      </view>

      <view class="appt-actions" wx:if="{{item.cancelable || item.visitId}}">
        <view class="btn-ghost danger" wx:if="{{item.cancelable}}" data-id="{{item.id}}" catchtap="onCancel">取消预约</view>
        <view class="btn-ghost action-gap" wx:if="{{item.visitId}}" data-visit-id="{{item.visitId}}" catchtap="goVisitDetail">查看就诊</view>
      </view>
    </view>

    <view class="group-title" wx:if="{{history.length}}">
      <text class="group-name">历史预约</text>
      <text class="group-count gray">{{history.length}}</text>
    </view>

    <view wx:for="{{history}}" wx:key="id" class="card appt-card">
      <view class="appt-top">
        <view class="appt-doctor">
          <text class="doctor-name">{{item.doctorName}}</text>
          <text class="doctor-title" wx:if="{{item.doctorTitle}}">{{item.doctorTitle}}</text>
        </view>
        <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
      </view>

      <view class="meta-row">
        <text class="meta-label">就诊时间</text>
        <text class="meta-value">{{item.dateTimeText}}</text>
      </view>
      <view class="meta-row">
        <text class="meta-label">预约号</text>
        <text class="meta-value">{{item.appointNo || '-'}}</text>
      </view>
      <view class="meta-row" wx:if="{{item.complaint}}">
        <text class="meta-label">主诉</text>
        <text class="meta-value">{{item.complaint}}</text>
      </view>

      <view class="appt-actions" wx:if="{{item.visitId}}">
        <view class="btn-ghost" data-visit-id="{{item.visitId}}" catchtap="goVisitDetail">查看就诊</view>
      </view>
    </view>
  </block>
</view>
