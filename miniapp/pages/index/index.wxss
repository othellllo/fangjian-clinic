.index-page {
  padding-top: 0;
}

.hero {
  margin: 0 -24rpx;
  padding: 28rpx 40rpx 36rpx;
  background: linear-gradient(135deg, #2f7d5d 0%, #3d9772 100%);
  border-radius: 0 0 32rpx 32rpx;
}

.hero-title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

/* ---------- 医生卡片 ---------- */
.doctor-card {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 28rpx 24rpx;
  background-color: #ffffff;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 45, 39, 0.05);
}

.doctor-hover {
  background-color: #f7faf8;
}

.doctor-selected {
  border-color: #2f7d5d;
  background-color: #f3faf7;
}

.doctor-avatar {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  background-color: #e7f3ed;
  border-radius: 50%;
  color: #2f7d5d;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.doctor-main {
  flex: 1;
  min-width: 0;
}

.doctor-name-row {
  display: flex;
  align-items: center;
}

.doctor-name {
  color: #1f2d27;
  font-size: 32rpx;
  font-weight: 600;
}

.doctor-title {
  margin-left: 12rpx;
  padding: 0 10rpx;
  background-color: #eef4f0;
  border-radius: 6rpx;
  color: #2f7d5d;
  font-size: 20rpx;
  line-height: 32rpx;
}

.doctor-dept {
  margin-top: 6rpx;
  color: #8a9490;
  font-size: 24rpx;
}

.doctor-intro {
  margin-top: 6rpx;
  overflow: hidden;
  color: #b4bdb9;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.doctor-selected .doctor-avatar {
  background-color: #2f7d5d;
  color: #ffffff;
}

.radio {
  position: relative;
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-left: 16rpx;
  border: 2rpx solid #d5e0da;
  border-radius: 50%;
}

.radio-on {
  border-color: #2f7d5d;
  background-color: #2f7d5d;
}

.radio-on::after {
  position: absolute;
  top: 9rpx;
  left: 9rpx;
  width: 14rpx;
  height: 14rpx;
  background-color: #ffffff;
  border-radius: 50%;
  content: '';
}

/* ---------- 日期横滑 ---------- */
.date-scroll {
  width: 100%;
  white-space: nowrap;
}

.date-row {
  display: inline-flex;
}

.date-item {
  flex: 0 0 auto;
  width: 116rpx;
  margin-right: 16rpx;
  padding: 18rpx 0 16rpx;
  background-color: #ffffff;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(31, 45, 39, 0.04);
}

.date-item:last-child {
  margin-right: 0;
}

.date-week {
  display: block;
  color: #8a9490;
  font-size: 22rpx;
}

.date-day {
  display: block;
  margin-top: 6rpx;
  color: #1f2d27;
  font-size: 28rpx;
  font-weight: 600;
}

.date-active {
  background-color: #2f7d5d;
  border-color: #2f7d5d;
}

.date-active .date-week,
.date-active .date-day {
  color: #ffffff;
}

/* ---------- 时段 ---------- */
.slot-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.slot-item {
  width: 31.5%;
  margin-bottom: 16rpx;
  padding: 22rpx 8rpx;
  background-color: #ffffff;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(31, 45, 39, 0.04);
}

.slot-time {
  display: block;
  color: #1f2d27;
  font-size: 26rpx;
  font-weight: 600;
}

.slot-meta {
  display: block;
  margin-top: 6rpx;
  color: #8a9490;
  font-size: 20rpx;
}

.slot-full {
  background-color: #f3f5f4;
  box-shadow: none;
}

.slot-full .slot-time {
  color: #b4bdb9;
}

.slot-full .slot-meta {
  color: #c3ccc8;
}

.slot-selected {
  background-color: #2f7d5d;
  border-color: #2f7d5d;
  box-shadow: none;
}

.slot-selected .slot-time,
.slot-selected .slot-meta {
  color: #ffffff;
}

/* ---------- 主诉 ---------- */
.textarea-box {
  position: relative;
  padding: 24rpx 24rpx 44rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 45, 39, 0.05);
}

.textarea {
  width: 100%;
  height: 140rpx;
  color: #1f2d27;
  font-size: 28rpx;
  line-height: 1.6;
}

.counter {
  position: absolute;
  right: 24rpx;
  bottom: 14rpx;
  color: #b4bdb9;
  font-size: 20rpx;
}

/* ---------- 底部提交栏 ---------- */
.submit-placeholder {
  height: 160rpx;
}

.submit-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -4rpx 24rpx rgba(31, 45, 39, 0.08);
}

.submit-summary {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.summary-main {
  overflow: hidden;
  color: #1f2d27;
  font-size: 26rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-sub {
  margin-top: 4rpx;
  color: #9aa5a0;
  font-size: 20rpx;
}

.submit-btn {
  flex-shrink: 0;
  width: 220rpx;
  height: 80rpx;
  font-size: 28rpx;
}
