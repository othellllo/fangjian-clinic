<view class="login-page">
  <view class="hero">
    <view class="logo">医</view>
    <view class="hero-title">医馆患者服务</view>
    <view class="hero-sub">预约挂号 · 就诊记录 · 处方费用</view>
  </view>

  <view class="card login-card">
    <view class="form-item">
      <view class="form-label">手机号</view>
      <input
        class="form-input"
        type="number"
        maxlength="11"
        value="{{phone}}"
        placeholder="请输入 11 位手机号"
        placeholder-style="color:#b4bdb9"
        cursor-spacing="24"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="form-item">
      <view class="form-label">验证码</view>
      <view class="code-row">
        <input
          class="form-input code-input"
          type="number"
          maxlength="6"
          value="{{code}}"
          placeholder="请输入验证码"
          placeholder-style="color:#b4bdb9"
          cursor-spacing="24"
          bindinput="onCodeInput"
          bindconfirm="onLogin"
        />
        <view class="code-btn {{canSendCode ? '' : 'code-btn-disabled'}}" hover-class="btn-hover" bindtap="onSendCode">
          <text wx:if="{{countdown > 0}}">{{countdown}}s 后重发</text>
          <text wx:else>获取验证码</text>
        </view>
      </view>
    </view>

    <view class="login-btn {{canLogin ? '' : 'btn-disabled'}}" hover-class="btn-hover" bindtap="onLogin">
      <text wx:if="{{submitting}}">登录中…</text>
      <text wx:else>登 录</text>
    </view>
  </view>

  <view class="login-footer">
    <view class="footer-demo">演示环境验证码 {{devCode}}</view>
    <view>本服务仅限本医馆就诊患者使用</view>
    <view>登录即代表同意《患者服务须知》</view>
  </view>
</view>
