.login-page {
  min-height: 100vh;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background-color: #f5f7f6;
}

.hero {
  padding: 64rpx 48rpx 112rpx;
  background: linear-gradient(135deg, #2f7d5d 0%, #3f9a74 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.logo {
  width: 112rpx;
  height: 112rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 28rpx;
  background-color: rgba(255, 255, 255, 0.18);
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 108rpx;
  text-align: center;
}

.hero-title {
  margin-top: 28rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.login-card {
  margin: -64rpx 24rpx 0;
  padding: 40rpx 32rpx 32rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  margin-bottom: 14rpx;
  color: #42504a;
  font-size: 26rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 92rpx;
  padding: 0 24rpx;
  background-color: #f5f7f6;
  border-radius: 12rpx;
  color: #1f2d27;
  font-size: 30rpx;
}

.code-row {
  display: flex;
  align-items: center;
}

.code-input {
  flex: 1;
}

.code-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 220rpx;
  height: 92rpx;
  margin-left: 16rpx;
  background-color: #e6f4ee;
  border-radius: 12rpx;
  color: #2f7d5d;
  font-size: 26rpx;
}

.code-btn-disabled {
  background-color: #f0f2f1;
  color: #a9b3ae;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin-top: 12rpx;
  background-color: #2f7d5d;
  border-radius: 16rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
}

.footer-demo {
  margin-bottom: 10rpx;
  color: #b5731a;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}

.login-footer {
  margin-top: 56rpx;
  color: #b4bdb9;
  font-size: 22rpx;
  line-height: 1.9;
  text-align: center;
}
