<view class="page detail-page">
  <view wx:if="{{loading}}" class="loading-tip">正在加载就诊详情…</view>

  <view wx:elif="{{error}}" class="empty">
    <view class="empty-icon">!</view>
    <view class="empty-text">就诊详情加载失败</view>
    <view class="empty-sub">请检查网络或后端服务是否正常</view>
    <view class="btn-primary empty-btn" hover-class="btn-hover" bindtap="onRetry">重新加载</view>
  </view>

  <block wx:elif="{{visit}}">
    <!-- 就诊概要 -->
    <view class="summary-card">
      <view class="summary-top">
        <view class="summary-doctor">
          <text class="summary-doctor-name">{{visit.doctorName || '医生'}}</text>
          <text class="summary-type" wx:if="{{visit.typeText}}">{{visit.typeText}}</text>
        </view>
        <text class="tag summary-tag {{visit.statusClass}}">{{visit.statusText}}</text>
      </view>
      <view class="summary-time">{{visit.timeText}}</view>
      <view class="summary-meta">
        <text wx:if="{{visit.visitNo}}">就诊号 {{visit.visitNo}}</text>
        <text wx:if="{{visit.queueNo}}"> · 排队号 {{visit.queueNo}}</text>
        <text wx:if="{{visit.hasRegisterFee}}"> · 挂号费 ¥{{visit.registerFeeText}}</text>
      </view>
    </view>

    <!-- 患者信息 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">患者信息</text>
      </view>
      <view class="card info-card">
        <view class="info-row">
          <text class="info-label">姓名</text>
          <text class="info-value">{{patient.name || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">性别 / 年龄</text>
          <text class="info-value">{{patient.genderText || '-'}}{{patient.ageText ? ' / ' + patient.ageText + ' 岁' : ''}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">手机号</text>
          <text class="info-value">{{patient.phone || '-'}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">病历号</text>
          <text class="info-value">{{patient.patientNo || '-'}}</text>
        </view>
        <view class="info-row" wx:if="{{patient.allergy}}">
          <text class="info-label">过敏史</text>
          <text class="info-value">{{patient.allergy}}</text>
        </view>
      </view>
    </view>

    <!-- 病历 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">病历</text>
        <text class="section-extra" wx:if="{{recordUpdatedText}}">更新于 {{recordUpdatedText}}</text>
      </view>
      <view wx:if="{{!hasRecord}}" class="hint-card">本次就诊暂无病历记录</view>
      <view wx:else class="card record-card">
        <view class="record-item" wx:for="{{recordSections}}" wx:key="key">
          <view class="record-label">{{item.label}}</view>
          <view class="record-value">{{item.value}}</view>
        </view>
      </view>
    </view>

    <!-- 处方 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">处方</text>
        <text class="section-extra" wx:if="{{prescriptions.length}}">共 {{prescriptions.length}} 张</text>
      </view>
      <view wx:if="{{!hasPrescriptions}}" class="hint-card">本次就诊暂无处方</view>
      <block wx:else>
        <view class="card rx-card" wx:for="{{prescriptions}}" wx:for-item="pres" wx:key="id">
          <view class="rx-head">
            <view class="rx-title">
              <text class="rx-type">{{pres.typeText}}</text>
              <text class="rx-no" wx:if="{{pres.prescriptionNo}}">{{pres.prescriptionNo}}</text>
            </view>
            <text class="tag {{pres.statusClass}}" wx:if="{{pres.statusText}}">{{pres.statusText}}</text>
          </view>

          <view class="rx-sub" wx:if="{{pres.decoctionMethod || pres.doses}}">
            <text wx:if="{{pres.decoctionMethod}}">煎法：{{pres.decoctionMethod}}</text>
            <text wx:if="{{pres.doses}}"> · {{pres.doses}} 剂</text>
          </view>

          <view class="rx-items">
            <view class="rx-item" wx:for="{{pres.items}}" wx:for-item="drug" wx:key="id">
              <view class="rx-drug-main">
                <text class="rx-drug-name">{{drug.drugName}}</text>
                <text class="rx-drug-spec" wx:if="{{drug.spec}}">{{drug.spec}}</text>
              </view>
              <view class="rx-drug-usage" wx:if="{{drug.usageText}}">{{drug.usageText}}</view>
              <view class="rx-drug-nums">
                <text class="rx-drug-dose" wx:if="{{drug.dose}}">剂量 {{drug.dose}}</text>
                <text class="rx-drug-qty" wx:if="{{drug.quantity}}">数量 {{drug.quantity}}{{drug.unit}}</text>
                <text class="rx-drug-amount">¥{{drug.amountText}}</text>
              </view>
            </view>
          </view>

          <view class="rx-total">
            <text class="rx-total-label">处方金额</text>
            <text class="rx-total-value">¥{{pres.totalAmountText}}</text>
          </view>
        </view>
      </block>
    </view>

    <!-- 费用 -->
    <view class="section">
      <view class="section-head">
        <text class="section-title">费用</text>
        <text class="section-extra" wx:if="{{hasCharges}}">合计 ¥{{chargeTotalText}}</text>
      </view>
      <view wx:if="{{!hasCharges}}" class="hint-card">本次就诊暂无费用记录</view>
      <block wx:else>
        <view class="card charge-card" wx:for="{{charges}}" wx:for-item="charge" wx:key="id">
          <view class="charge-head">
            <view class="charge-title">
              <text class="charge-type">{{charge.typeText}}</text>
              <text class="charge-no" wx:if="{{charge.orderNo}}">{{charge.orderNo}}</text>
            </view>
            <text class="tag {{charge.statusClass}}">{{charge.statusText}}</text>
          </view>

          <view class="charge-items" wx:if="{{charge.items.length}}">
            <view class="charge-item" wx:for="{{charge.items}}" wx:for-item="ci" wx:key="id">
              <text class="charge-item-name">{{ci.itemName}}</text>
              <text class="charge-item-qty">×{{ci.quantity}}</text>
              <text class="charge-item-amount">¥{{ci.amountText}}</text>
            </view>
          </view>

          <view class="charge-foot">
            <view class="charge-line">
              <text>应收</text>
              <text>¥{{charge.payableAmountText}}</text>
            </view>
            <view class="charge-line" wx:if="{{charge.hasDiscount}}">
              <text>优惠</text>
              <text>-¥{{charge.discountAmountText}}</text>
            </view>
            <view class="charge-line strong">
              <text>实收</text>
              <text>¥{{charge.paidAmountText}}</text>
            </view>
          </view>

          <view class="charge-time" wx:if="{{charge.paidAtText}}">
            支付时间 {{charge.paidAtText}}<text wx:if="{{charge.payMethodText}}"> · {{charge.payMethodText}}</text>
          </view>
          <view class="charge-time" wx:if="{{charge.createdAtText}}">开单时间 {{charge.createdAtText}}</view>
        </view>
      </block>
    </view>

    <view class="detail-footer">以上病历与处方内容仅供参考，用药请遵医嘱</view>
  </block>
</view>
