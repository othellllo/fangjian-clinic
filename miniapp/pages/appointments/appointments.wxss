.appointments-page {
  padding-top: 0;
}

.hero {
  margin: 0 -24rpx;
  padding: 28rpx 40rpx 36rpx;
  background: linear-gradient(135deg, #2f7d5d 0%, #3d9772 100%);
  border-radius: 0 0 32rpx 32rpx;
}

.hero-title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.gap-top {
  margin-top: 28rpx;
}

.group-title {
  display: flex;
  align-items: center;
  margin: 32rpx 8rpx 16rpx;
}

.group-name {
  color: #1f2d27;
  font-size: 30rpx;
  font-weight: 600;
}

.group-count {
  margin-left: 12rpx;
  padding: 0 12rpx;
  background-color: #e7f3ed;
  border-radius: 8rpx;
  color: #2f7d5d;
  font-size: 20rpx;
  line-height: 32rpx;
}

.group-count.gray {
  background-color: #eef0ef;
  color: #8a9490;
}

.appt-card {
  margin-bottom: 16rpx;
  padding: 28rpx 24rpx;
}

.appt-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.appt-doctor {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.doctor-name {
  overflow: hidden;
  color: #1f2d27;
  font-size: 32rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.doctor-title {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 0 10rpx;
  background-color: #eef4f0;
  border-radius: 6rpx;
  color: #2f7d5d;
  font-size: 20rpx;
  line-height: 32rpx;
}

.meta-row {
  display: flex;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.meta-label {
  flex-shrink: 0;
  width: 120rpx;
  color: #9aa5a0;
}

.meta-value {
  flex: 1;
  color: #42504a;
  word-break: break-all;
}

.appt-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.action-gap {
  margin-left: 16rpx;
}

.link-text {
  margin-left: 8rpx;
  color: #2f7d5d;
}
